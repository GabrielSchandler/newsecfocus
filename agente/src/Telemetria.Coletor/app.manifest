<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="Telemetria.Coletor" type="win32" />

  <!-- asInvoker: o coletor roda no nível do usuário logado, nunca elevado.
       Hooks de baixo nível de uma sessão comum enxergam a própria sessão. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Ciência de Windows 10/11 para GetForegroundWindow e UI Automation
       devolverem estado correto. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- A ciência de DPI NÃO fica aqui: em projetos Windows Forms o SDK exige que
       seja declarada pela propriedade ApplicationHighDpiMode do .csproj (aviso
       WFAC010). Ver <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
       em Telemetria.Coletor.csproj. -->
</assembly>
