<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF só para ter acesso ao System.Windows.Automation (UI Automation gerenciado),
         usado na extração do domínio do navegador. Nenhuma janela WPF é criada. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Telemetria.Coletor</RootNamespace>
    <AssemblyName>Telemetria.Coletor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sem console, sem janela: processo silencioso na sessão do usuário. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telemetria.Nucleo\Telemetria.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
